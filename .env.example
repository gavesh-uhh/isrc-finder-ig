# MusicBrainz asks API clients to identify themselves with a descriptive User-Agent.
# Include a contact URL or email in production.
MUSICBRAINZ_USER_AGENT=ISRC-Finder/1.0 (https://github.com/your-account/your-repo)

# Optional: enables Spotify autocomplete, album covers, and catalog enrichment.
# Create an app in the Spotify developer dashboard and use its Client Credentials flow.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
